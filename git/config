[user]
	name = Boran Seckin
	email = boran@boranseckin.com

[init]
	defaultBranch = main

[core]
	untrackedCache = true

[diff]
	algorithm = histogram
  colorMoved = plain
  renames = true
  mnemonicPrefix = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[push]
  autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autostash = true
  autoSquash = true
  updateRefs = true

[rerere]
	enabled = true
  autoupdate = true

[merge]
  conflictStyle = zdiff3

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[commit]
  verbose = true

[column]
  ui = auto

[advice]
	addIgnoredFile = false

[help]
  autocorrect = prompt

[alias]
  st = status
	logs = log --shortstat
  gpg = log --show-signature
  tree = log --graph --decorate --abbrev-commit --branches --tags --remotes --date=short --pretty=format:'%C(yellow)%h%Creset-%C(cyan)(%ai%x08%x08%x08%x08%x08%x08) %ar%Creset%C(bold green)%d%Creset %s %Creset %C(cyan)[%cn]%Creset'

# https://blog.gitbutler.com/how-git-core-devs-configure-git/
